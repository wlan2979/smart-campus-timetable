# ==============================================================================
# 智能校园课表 App - 环境配置模板 (.env.example)
# 复制本文件为 .env 并填入真实凭证；切勿将真实 .env 提交到版本控制系统。
# ==============================================================================

# ---------- 后端基础配置 ----------
SERVER_PORT=8080
# 可选值: dev (仅本地开发，启用开发态短信日志输出), prod (生产环境，严格禁用任何测试验证码)
SPRING_PROFILES_ACTIVE=dev

# ---------- PostgreSQL 数据库 ----------
POSTGRES_DB=campus_timetable
POSTGRES_USER=timetable_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_URL=jdbc:postgresql://postgres:5432/campus_timetable

# ---------- Redis 缓存（验证码限流与会话缓存，可选启用） ----------
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT 密钥（生产环境必须使用 >= 32 字节的高熵随机密钥） ----------
JWT_SECRET=CHANGE_ME_REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_KEY
JWT_ACCESS_EXPIRATION_SECONDS=7200
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# ---------- 短信验证码服务商配置 ----------
# 可选值: aliyun (生产推荐), debug_log (仅 dev/local profile 允许，prod 启动即拒绝)
SMS_PROVIDER=debug_log
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# ---------- 第三方天气 API（可选，客户端默认支持免密钥真实 Open-Meteo，也可切换和风天气） ----------
# 推荐通过后端代理转发和风天气请求，避免在客户端 APK 中暴露密钥
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# ---------- 法定节假日权威数据源（国务院办公厅年度安排镜像 JSON） ----------
# 模板中的 {year} 会替换为目标年份，例如 2026
HOLIDAY_REMOTE_URL_TEMPLATE=https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/{year}.json

# ---------- 全国高校目录远程更新（可选） ----------
# 留空时客户端自动使用自建后端的 GET /api/v1/schools/catalog；
# 也可指向任意托管了 schools_catalog_v2.json 的静态地址（如 CDN / GitHub Raw）
SCHOOL_CATALOG_REMOTE_URL=

# ---------- Android 客户端可选构建配置（写入 android/local.properties，勿硬编码源码） ----------
# TIMETABLE_API_BASE_URL=http://10.0.2.2:8080/
# QWEATHER_API_HOST=
# QWEATHER_API_KEY=
# SCHOOL_CATALOG_REMOTE_URL=
